# 복사해서 application-local.yml 로 사용하세요 (git 미추적)
spring:
  datasource:
    driver-class-name: org.postgresql.Driver
    url: jdbc:postgresql://localhost:YOUR_DB_PORT_ENV/YOUR_DB_NAME_ENV
    username: YOUR_DB_USER_ENV
    password: YOUR_DB_PASSWORD_ENV
  jpa:
    hibernate:
      ddl-auto: update      # 로컬 개발 중에만. 절대 운영에 쓰지 말 것
    show-sql: true

# Ollama 로컬 임베딩 생성 시 활성화 (Spring AI 최신 규격)
  ai:
    ollama:
      base-url: http://localhost:11434
      embedding:
        model: nomic-embed-text

app:
  jwt:
    cookie-secure: false    # 로컬은 http라서 Secure 쿠키를 쓰면 브라우저가 저장을 거부합니다